{
  "name": "core-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": { "express": "^5.2.1", "ws": "^8.21.3" },
  "devDependencies": {
    "@types/express": "^5.0.6", "@types/node": "^20.19.43",
    "@types/ws": "^8.18.1", "tsx": "^4.23.15", "typescript": "^7.0.2"
  }
}
